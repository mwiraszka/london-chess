{
  "name": "lcc-server",
  "version": "6.5.0",
  "description": "REST API for the London Chess Club website, built with Node and Express",
  "author": "Michal Wiraszka",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/london-chess.git"
  },
  "private": true,
  "scripts": {
    "backup": "npx tsx --env-file=.env scripts/backup.ts",
    "start": "npx tsx watch --env-file=.env src/server.ts",
    "start:e2e": "tsx e2e/server.ts",
    "tunnel": "ngrok http 3000 --log stdout --log-level warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**' 'api/**' 'e2e/**' 'scripts/**'",
    "format": "prettier --write 'src/**/*.ts' 'api/**/*.ts' 'e2e/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'api/**/*.ts' 'e2e/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@clerk/backend": "3.23.2",
    "@sentry/node": "11.6.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "mongoose": "9.11.1",
    "multer": "2.4.0",
    "nodemailer": "10.1.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": ">=5.0.12",
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "qs@<6.16.0": ">=6.16.0",
      "@humanfs/node@<0.16.8": ">=0.16.8",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
