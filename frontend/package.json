{
  "name": "lcc-frontend",
  "version": "6.5.0",
  "description": "Frontend for the London Chess Club website, built with Angular",
  "author": "Michal Wiraszka",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/london-chess.git"
  },
  "private": false,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-data.mjs && ng serve -o",
    "start:no-hmr": "node scripts/generate-data.mjs && ng serve -o --no-hmr",
    "start:prod": "node scripts/generate-data.mjs && ng serve -o --configuration production",
    "build:dev": "node scripts/generate-data.mjs && ng build",
    "build:preview": "node scripts/generate-data.mjs && ng build --configuration preview",
    "build:prod": "node scripts/generate-data.mjs && ng build --configuration production",
    "build:stats": "node scripts/generate-data.mjs && ng build --stats-json && echo 'Load dist/browser-stats.json into https://esbuild.github.io/analyze/'",
    "watch": "node scripts/generate-data.mjs && ng build --watch --configuration development",
    "test": "node scripts/generate-data.mjs && ng test",
    "test:watch": "node scripts/generate-data.mjs && ng test --watch",
    "test:coverage": "node scripts/generate-data.mjs && ng test --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright install chromium && playwright test",
    "lint": "eslint 'src/**'"
  },
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@clerk/clerk-js": "6.37.0",
    "@eagami/ui": "5.60.1",
    "@googlemaps/js-api-loader": "2.1.3",
    "@ngrx/effects": "22.0.1",
    "@ngrx/entity": "22.0.1",
    "@ngrx/operators": "22.0.1",
    "@ngrx/router-store": "22.0.1",
    "@ngrx/store": "22.0.1",
    "@ngrx/store-devtools": "22.0.1",
    "@sentry/angular": "11.4.0",
    "lichess-pgn-viewer": "2.4.5",
    "lodash-es": "4.18.1",
    "marked": "18.0.14",
    "moment-timezone": "0.6.5",
    "ng2-pdf-viewer": "10.4.0",
    "ngrx-store-localstorage": "20.1.0",
    "ngx-markdown": "22.0.0",
    "papaparse": "5.7.0",
    "read-excel-file": "9.3.10",
    "remove-markdown": "0.7.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@clerk/testing": "2.2.42",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/google.maps": "3.66.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "chessground": "9.2.1",
      "prebuild-install": "7.1.3",
      "whatwg-encoding": "3.1.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "canvas",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "lodash-es@>=4.0.0 <=4.17.23": ">=4.18.0",
      "dompurify@<3.4.0": ">=3.4.0",
      "fast-uri@<4.1.5": ">=4.1.5",
      "hono@<4.13.5": ">=4.13.5",
      "ip-address@<10.3.1": ">=10.3.1",
      "mermaid@<11.15.0": ">=11.15.0",
      "uuid@<14.0.0": ">=14.0.0",
      "@babel/core": "7.29.7",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@<4.2.0": ">=4.2.0",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "ws@<8.21.0": ">=8.21.0",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "immutable@>=5.0.0 <5.1.8": ">=5.1.8",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": ">=5.0.12",
      "stream-json@<3.5.0": ">=3.5.0",
      "moment@<2.31.0": ">=2.31.0"
    }
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
